# Cloudflare Wrangler token (optional — only needed for automated deploys)
# CLOUDFLARE_API_TOKEN=your_token_here

# Email worker integration (see integrations/email-cloudflare-resend/)
# EMAIL_WORKER_URL=https://your-worker.your-subdomain.workers.dev/send
# EMAIL_RECIPIENT=hello@example.com
# EMAIL_SENDER=noreply@example.com

# Client-side public variables
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# PUBLIC_ANALYTICS_ID=
