---
import { CONTACT } from '../consts';
const today = new Date();
---

<footer class="border-t-thin border-border/15 bg-background">
	<!-- CTA Section -->
	<div class="items-center gap-8 grid grid-cols-1 md:grid-cols-2 mx-auto px-3 md:px-8 py-16 max-w-6xl">
		<div>
			<h2 class="fs-h3 font-display font-light text-text-secondary">
				Need something tailored?
			</h2>
			<p class="mt-3 max-w-md font-sans text-text-primary/80 text-base leading-relaxed tracking-wide">
				This template is just a starting point. I can adapt it to your brand,
				wire up a CMS, or build entirely custom components.
			</p>
		</div>
		<div class="flex md:justify-end">
			<a
				href="/contact"
				class="group inline-flex items-center gap-2 btn-fill-primary px-7 py-3.5 border border-white/15 rounded-sm font-medium text-text-secondary hover:text-background text-sm uppercase tracking-wider transition-all duration-300 btn-fill"
			>
				Get in touch
				<svg
					class="size-4 group-hover:translate-x-0.5 transition-transform duration-300"
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 256 256"
					fill="currentColor"
				>
					<path
						d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"
					></path>
				</svg>
			</a>
		</div>
	</div>

	<!-- Bottom Bar -->
	<div class="border-t border-border/10">
		<div
			class="flex flex-col sm:flex-row justify-between items-center gap-4 mx-auto px-3 md:px-8 py-6 max-w-6xl"
		>
			<p class="font-sans text-text-primary/60 text-sm">
				&copy; {today.getFullYear()} DevGarden. All rights reserved.
			</p>
			<div class="flex items-center gap-6">
				<a
					href={CONTACT.github}
					class="font-sans text-text-primary/60 hover:text-primary text-sm transition-colors duration-200"
				>
					GitHub
				</a>
				<a
					href={CONTACT.email}
					class="font-sans text-text-primary/60 hover:text-primary text-sm transition-colors duration-200"
				>
					Email
				</a>
			</div>
		</div>
	</div>
</footer>
