---
import HeaderLink from "./HeaderLink.astro";
import ContactLinks from "./ContactLinks.astro";
import { SITE_TITLE } from "../consts";
---

<header
    id="site-header"
    class="bg-surface/80 backdrop-blur-md border-b-thin border-border/20 w-full sticky top-0 z-50 transition-transform duration-300 ease-expo-out"
>
    <div
        class="flex justify-between items-center mx-auto px-3 md:px-8 py-4 max-w-6xl"
    >
        <a
            href="/"
            class="font-sans font-semibold text-primary text-lg tracking-wide"
        >
            {SITE_TITLE}
        </a>

        <nav class="hidden md:flex items-center gap-1">
            <HeaderLink href="/">Log</HeaderLink>
            <HeaderLink href="/lab">Lab</HeaderLink>
            <HeaderLink href="/blog">Archive</HeaderLink>
            <HeaderLink href="/about">About</HeaderLink>
        </nav>

        <div class="flex items-center gap-2">
            <ContactLinks />

            <button
                type="button"
                class="md:hidden btn-icon btn-ghost"
                onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))"
                aria-label="Toggle navigation"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M4 5h16"></path><path d="M4 12h16"></path><path
                        d="M4 19h16"></path></svg
                >
            </button>
        </div>
    </div>
</header>

<script>
    (function () {
        const header = document.getElementById('site-header');
        const sidebar = document.querySelector('.sidebar');
        if (!header) return;

        let lastScrollY = window.scrollY;
        let ticking = false;
        let sidebarOpen = false;
        const threshold = 50;

        function updateVisibility() {
            if (sidebarOpen) {
                header.classList.add('-translate-y-full');
                return;
            }

            const currentScrollY = window.scrollY;

            if (currentScrollY < threshold) {
                header.classList.remove('-translate-y-full');
            } else if (currentScrollY > lastScrollY) {
                header.classList.add('-translate-y-full');
            } else {
                header.classList.remove('-translate-y-full');
            }

            lastScrollY = currentScrollY;
        }

        function onScroll() {
            if (!ticking) {
                requestAnimationFrame(() => {
                    updateVisibility();
                    ticking = false;
                });
                ticking = true;
            }
        }

        window.addEventListener('scroll', onScroll, { passive: true });

        // Hide header when mobile sidebar opens, show when it closes
        function syncSidebarState() {
            sidebarOpen = sidebar
                ? sidebar.getAttribute('aria-hidden') === 'false'
                : false;
            if (sidebarOpen) {
                header.classList.add('-translate-y-full');
            } else {
                header.classList.remove('-translate-y-full');
            }
        }

        document.addEventListener('basecoat:sidebar', () => {
            // Sidebar toggles async — check state after a tick
            requestAnimationFrame(syncSidebarState);
        });

        // Also observe aria-hidden changes on sidebar
        if (sidebar) {
            new MutationObserver(syncSidebarState).observe(sidebar, {
                attributes: true,
                attributeFilter: ['aria-hidden'],
            });
        }
    })();
</script>