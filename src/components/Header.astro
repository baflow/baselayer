---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header class="w-full bg-surface border-b border-accent">
    <div
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-8"
    >
        <a
            href="/"
            class="font-display text-lg font-semibold tracking-wide text-primary"
        >
            {SITE_TITLE}
        </a>

        <nav class="hidden items-center gap-1 md:flex">
            <HeaderLink href="/">Log</HeaderLink>
            <HeaderLink href="/lab">Lab</HeaderLink>
            <HeaderLink href="/blog">Archive</HeaderLink>
            <HeaderLink href="/about">About</HeaderLink>
        </nav>

        <button
            type="button"
            class="btn-icon btn-ghost md:hidden"
            onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))"
            aria-label="Toggle navigation"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M4 5h16"></path><path d="M4 12h16"></path><path
                    d="M4 19h16"></path></svg
            >
        </button>
    </div>
</header>
