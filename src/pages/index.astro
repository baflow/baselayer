---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.svelte';
import SectionHeader from '../components/ui/SectionHeader.svelte';
import Card from '../components/ui/Card.svelte';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 7);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  }).toUpperCase();
}
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="min-h-screen">
    <Hero client:load />

    <section class="mx-auto px-3 md:px-6 py-12 max-w-6xl">
      <div class="gap-8 grid grid-cols-1 lg:grid-cols-2">
        <!-- Personal Log -->
        <div class="group/section">
          <SectionHeader title="PERSONAL LOG" />
          <div class="flex flex-col gap-4">
            {
              posts.map((post) => (
                <Card
                  href={`/blog/${post.id}/`}
                  date={fmtDate(post.data.pubDate)}
                  title={post.data.title}
                  description={post.data.description}
                />
              ))
            }
          </div>
          <a
            href="/blog/"
            class="flex justify-center items-center gap-2 mt-4 px-4 py-2 border border-white/10 hover:border-white/20 rounded-sm w-full font-medium text-text-primary hover:text-white text-sm transition-all duration-300 btn-ghost"
          >
            View Archive
          </a>
        </div>

        <!-- Laboratory -->
        <div class="group/section">
          <SectionHeader title="LABORATORY" />
          <div class="flex flex-col gap-4">
            {
              projects.map((project) => (
                <Card
                  href={`/lab/${project.id}/`}
                  title={project.data.title}
                  description={project.data.description}
                  image={project.data.image?.src}
                  tags={project.data.tags}
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
