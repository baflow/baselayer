---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ui/ContactForm.svelte';

const WORKER_URL = import.meta.env.EMAIL_WORKER_URL ?? '';
const RECIPIENT = import.meta.env.EMAIL_RECIPIENT ?? 'hello@example.com';
const SENDER = import.meta.env.EMAIL_SENDER ?? 'noreply@example.com';
---

<BaseLayout title="Contact — Baselayer">
	<main>
		<ContactForm
			workerUrl={WORKER_URL}
			recipientEmail={RECIPIENT}
			senderEmail={SENDER}
			client:load
		/>
	</main>
</BaseLayout>
