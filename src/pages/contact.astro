---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ui/ContactForm.svelte';

const WORKER_URL = 'https://email-cloudflare-resend.rapatatui.workers.dev/send';
const RECIPIENT = 'rapatatui@gmail.com';
---

<BaseLayout title="Contact — Baselayer">
	<main>
		<ContactForm
			workerUrl={WORKER_URL}
			recipientEmail={RECIPIENT}
			client:load
		/>
	</main>
</BaseLayout>
