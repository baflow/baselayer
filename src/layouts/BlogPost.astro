---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleMeta from '../components/ui/ArticleMeta.svelte';
import ImageWithCaption from '../components/ui/ImageWithCaption.svelte';

type Props = CollectionEntry<'blog'>['data'] & {
	postId?: string;
	postBody?: string;
};

const { title, description, pubDate, updatedDate, heroImage, postId = 'unknown', postBody } = Astro.props;

const wordCount = postBody ? postBody.split(/\s+/).filter(Boolean).length : 0;
const readTime = `${Math.max(1, Math.ceil(wordCount / 200))} MIN READ`;
const systemId = postId === 'unknown' ? 'SYSTEM.LOG.UNKNOWN' : `SYSTEM.LOG.${postId.toUpperCase().replace(/-/g, '_')}`;
---

<BaseLayout title={title} description={description}>
	<main class="mx-auto px-3 md:px-6 py-12 max-w-[900px]">
		<article class="flex flex-col gap-10">
			<!-- Article Header -->
			<header class="flex flex-col gap-4">
				<ArticleMeta label={systemId} date={pubDate} readTime={readTime} />
				<h1 class="font-display text-display-lg text-text-secondary mt-2">{title}</h1>
				<p class="font-sans prose-lead max-w-[80%]">{description}</p>
			</header>

			<!-- Hero Image -->
			{heroImage && (
				<ImageWithCaption
					src={heroImage.src}
					alt={title}
					caption={`Fig. 1.0 — ${title}`}
					client:visible
				/>
			)}

			<!-- Prose Content -->
			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>
