---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, image, tags } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<main class="mx-auto px-3 md:px-6 py-12 max-w-3xl">
		<article class="flex flex-col gap-6">
			{
				image && (
					<div class="aspect-video overflow-hidden rounded-md border-default border-border-card">
						<Image width={1020} height={510} src={image} alt={title} class="w-full h-full object-cover" />
					</div>
				)
			}

			<div class="flex flex-col gap-2">
				<div class="font-sans text-sm text-text-primary/60">
					<FormattedDate date={pubDate} />
				</div>
				<h1 class="font-display text-3xl text-text-secondary">{title}</h1>
				{
					tags && tags.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{tags.map((tag) => (
								<span class="inline-flex items-center px-2 py-0.5 text-[10px] uppercase tracking-widest font-medium text-text-primary/60 bg-surface border-thin border-border/25 rounded-sm">
									{tag}
								</span>
							))}
						</div>
					)
				}
			</div>

			<hr class="border-hairline border-border/40" />

			<div class="prose prose-invert max-w-none">
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>
